# ---------- Server ----------
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# ---------- Database (PostgreSQL) ----------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dexterity?schema=public"

# ---------- Auth ----------
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ---------- Google Calendar (OPTIONAL) ----------
# Leave these blank to run in MOCK mode (no Google account needed).
# Fill ALL THREE credentials to create real Calendar events + Google Meet links.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# ---------- Stripe (OPTIONAL) ----------
# Leave blank to run in MOCK payment mode (a fake checkout page).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
